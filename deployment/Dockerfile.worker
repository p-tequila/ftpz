FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-platform.txt ./
RUN pip install --no-cache-dir -r requirements-platform.txt
COPY nftpz_platform ./nftpz_platform
COPY diabetes_demo ./diabetes_demo
RUN useradd --uid 10001 --create-home worker
USER 10001:10001
ENTRYPOINT ["python", "-m", "nftpz_platform.cloud_worker"]
